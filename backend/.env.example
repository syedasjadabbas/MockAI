# MockAI Backend Environment Variables
# Copy this file to .env and fill in your values

# --- Security ---
SECRET_KEY=your-very-secret-jwt-key-change-this-in-production

# Shared secret for the internal evaluation-results endpoint
# (PUT /internal/evaluations/{id}) - held by the future AI worker/pipeline
# process, never by the Candidate frontend or an Admin session.
INTERNAL_SERVICE_KEY=your-internal-service-key-change-this-in-production

# Password given to a standard admin account only when that account does not
# exist yet (see utils/admin_bootstrap.py). Existing passwords are never reset.
# Leave empty to never auto-create admins. Change it after first login.
ADMIN_BOOTSTRAP_PASSWORD=

# --- Database ---
MONGO_URI=mongodb://localhost:27017
DATABASE_NAME=mockai
# Test scripts (backend/test_*.py) automatically use DATABASE_NAME + "_test";
# override here if needed, then seed it once with `python setup_test_db.py`.
# TEST_DATABASE_NAME=mockai_test

# --- SMTP Email (Gmail SMTP) ---
# For Gmail, SMTP_PASSWORD MUST be a 16-character Google App Password (not your normal Gmail password).
# Generate one at: https://myaccount.google.com/apppasswords (requires 2-Step Verification enabled).
SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# --- File Uploads ---
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=2

# --- Interview response media (local dev storage - see
# services/media_storage.py; a future S3/cloud-storage implementation
# would not need these) ---
MEDIA_STORAGE_DIR=media
MAX_RESPONSE_MEDIA_MB=25

# --- Speech-to-Text (FR15) ---
# Path to a Google Cloud service-account JSON key file. Not set = ASR
# honestly reports "failed: not configured", never a fabricated transcript.
# Never commit the key file itself.
GOOGLE_APPLICATION_CREDENTIALS=

# --- Google OAuth (Candidate Sign-In) ---
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# --- CORS & Networking (Production) ---
# Comma-separated list of allowed frontend origins:
ALLOWED_ORIGINS=https://mockai-frontend.onrender.com,https://your-custom-domain.com
FRONTEND_URL=https://mockai-frontend.onrender.com


# --- AI model profile (services/ai_profile.py) ---
# report = exact FYP-I report stack: DistilBERT (NLP), BERT-CoLA (grammar),
#          DeepFace CNN (facial emotion). ~2-3 GB RAM, Python 3.11/3.12,
#          install backend/requirements-report.txt. Use for local runs.
# lite   = MiniLM, rule-based grammar, FERPlus ONNX. For small cloud servers.
AI_PROFILE=lite
